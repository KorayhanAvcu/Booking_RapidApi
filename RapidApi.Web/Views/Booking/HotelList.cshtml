@model HotelListViewModel
@{
    var name = string.IsNullOrWhiteSpace(Model.DestinationLabel) ? Model.Destination : Model.DestinationLabel;
    var hasSearch = !string.IsNullOrWhiteSpace(Model.Destination);

    ViewData["Title"] = hasSearch ? $"{name} Otelleri" : "Otel Ara";
    ViewData["Description"] = hasSearch ? $"{name} bölgesindeki konaklama seçeneklerini keşfedin." : "Konaklama seçeneklerini keşfedin.";
    ViewData["ActivePage"] = "hotels";

    var tr = new System.Globalization.CultureInfo("tr-TR");
    var checkinStr = Model.Checkin.ToString("yyyy-MM-dd");
    var checkoutStr = Model.Checkout.ToString("yyyy-MM-dd");
    var guestText = $"{Model.Adults} yetişkin" + (Model.ChildCount > 0 ? $", {Model.ChildCount} çocuk" : "");

    // Seçili filtreler
    var selectedStars = (Model.Stars ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var hasFilters = selectedStars.Length > 0 || Model.MinScore.HasValue || Model.FreeCancellation
                     || Model.Breakfast || Model.MinPrice.HasValue || Model.MaxPrice.HasValue;

    // Sayfalama linkleri: arama + filtreler korunur, sadece sayfa değişir
    Dictionary<string, string> PageRoute(int p)
    {
        var d = new Dictionary<string, string?>
        {
            ["destination"] = Model.Destination,
            ["checkin"] = checkinStr,
            ["checkout"] = checkoutStr,
            ["adults"] = Model.Adults.ToString(),
            ["childrenAges"] = Model.ChildrenAges,
            ["rooms"] = Model.Rooms.ToString(),
            ["currency"] = Model.Currency,
            ["sortBy"] = Model.SortBy,
            ["stars"] = Model.Stars,
            ["minScore"] = Model.MinScore?.ToString(),
            ["freeCancellation"] = Model.FreeCancellation ? "true" : null,
            ["breakfast"] = Model.Breakfast ? "true" : null,
            ["minPrice"] = Model.MinPrice?.ToString(),
            ["maxPrice"] = Model.MaxPrice?.ToString(),
            ["page"] = p.ToString()
        };
        return d.Where(kv => !string.IsNullOrEmpty(kv.Value)).ToDictionary(kv => kv.Key, kv => kv.Value!);
    }

    // "Tümünü Temizle": aramayı korur, filtreleri ve sayfayı sıfırlar
    var clearRoute = new Dictionary<string, string>
    {
        ["destination"] = Model.Destination,
        ["checkin"] = checkinStr,
        ["checkout"] = checkoutStr,
        ["adults"] = Model.Adults.ToString(),
        ["rooms"] = Model.Rooms.ToString(),
        ["currency"] = Model.Currency
    };
    if (!string.IsNullOrEmpty(Model.ChildrenAges)) clearRoute["childrenAges"] = Model.ChildrenAges;
    if (!string.IsNullOrEmpty(Model.SortBy)) clearRoute["sortBy"] = Model.SortBy;

    var firstItem = Model.Hotels.Count == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    var lastItem = Model.Hotels.Count == 0 ? 0 : firstItem + Model.Hotels.Count - 1;
    var pageStart = Math.Max(1, Model.Page - 2);
    var pageEnd = Math.Min(Model.TotalPages, Model.Page + 2);

    var scoreOptions = new[] { (9, "Olağanüstü"), (8, "Çok İyi"), (7, "İyi"), (6, "Keyifli") };
}

@section Styles {
    <link rel="stylesheet" href="~/css/hotel-list.css" asp-append-version="true" />
}

<main>

    <!-- Search Summary -->
    <section class="search-summary">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb sf-breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Ana Sayfa</a></li>
                    <li class="breadcrumb-item"><a asp-action="HotelList">Oteller</a></li>
                    @if (hasSearch)
                    {
                        <li class="breadcrumb-item active" aria-current="page">@name</li>
                    }
                </ol>
            </nav>

            <h1 class="page-title">@(hasSearch ? $"{name} Otelleri" : "Otel Ara")</h1>
            <p class="page-text">
                @(hasSearch ? $"{name} bölgesindeki konaklama seçeneklerini keşfedin." : "Gitmek istediğiniz yeri yazın, konaklama seçeneklerini keşfedin.")
            </p>

            @* Bu form hem arama alanlarını hem de sayfadaki filtre/sıralama alanlarını gönderir (form="searchForm") *@
            <form id="searchForm" class="summary-panel" asp-controller="Booking" asp-action="HotelList" method="get" role="search">
                <div class="row g-2 g-lg-0 align-items-stretch">
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="summary-field" for="sDestination">
                            <i class="bi bi-geo-alt"></i>
                            <span class="summary-body">
                                <span class="summary-label">Lokasyon</span>
                                <input type="text" id="sDestination" name="destination" class="summary-input" value="@Model.Destination" placeholder="Şehir veya bölge" required>
                            </span>
                        </label>
                    </div>
                    <div class="col-6 col-md-3 col-lg">
                        <label class="summary-field" for="sCheckin">
                            <i class="bi bi-calendar3"></i>
                            <span class="summary-body">
                                <span class="summary-label">Giriş</span>
                                <input type="date" id="sCheckin" name="checkin" class="summary-input" value="@checkinStr">
                            </span>
                        </label>
                    </div>
                    <div class="col-6 col-md-3 col-lg">
                        <label class="summary-field" for="sCheckout">
                            <i class="bi bi-calendar3"></i>
                            <span class="summary-body">
                                <span class="summary-label">Çıkış</span>
                                <input type="date" id="sCheckout" name="checkout" class="summary-input" value="@checkoutStr">
                            </span>
                        </label>
                    </div>
                    <div class="col-6 col-md-3 col-lg-auto">
                        <label class="summary-field" for="sAdults">
                            <i class="bi bi-people"></i>
                            <span class="summary-body">
                                <span class="summary-label">Yetişkin</span>
                                <input type="number" id="sAdults" name="adults" class="summary-input" min="1" max="30" value="@Model.Adults">
                            </span>
                        </label>
                    </div>
                    <div class="col-6 col-md-3 col-lg">
                        <label class="summary-field" for="sChildren">
                            <span class="summary-body">
                                <span class="summary-label">Çocuk Yaşları</span>
                                <input type="text" id="sChildren" name="childrenAges" class="summary-input" value="@Model.ChildrenAges" placeholder="Örn: 5,8">
                            </span>
                        </label>
                    </div>
                    <div class="col-6 col-md-3 col-lg-auto">
                        <label class="summary-field" for="sRooms">
                            <i class="bi bi-door-closed"></i>
                            <span class="summary-body">
                                <span class="summary-label">Oda</span>
                                <input type="number" id="sRooms" name="rooms" class="summary-input" min="1" max="10" value="@Model.Rooms">
                            </span>
                        </label>
                    </div>
                    <div class="col-6 col-md-3 col-lg-auto">
                        <label class="summary-field" for="sCurrency">
                            <span class="summary-body">
                                <span class="summary-label">Para Birimi</span>
                                <select id="sCurrency" name="currency" class="summary-input summary-select">
                                    <option value="EUR" selected="@(Model.Currency == "EUR")">EUR</option>
                                    <option value="USD" selected="@(Model.Currency == "USD")">USD</option>
                                    <option value="TRY" selected="@(Model.Currency == "TRY")">TRY</option>
                                    <option value="GBP" selected="@(Model.Currency == "GBP")">GBP</option>
                                </select>
                            </span>
                        </label>
                    </div>
                    <div class="col-12 col-lg-auto summary-btn-col">
                        <button type="submit" class="btn btn-update w-100" aria-label="Aramayı Güncelle">
                            <i class="bi bi-search"></i>
                            <span class="btn-update-label">Aramayı Güncelle</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <section class="results-section">
        <div class="container">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-warning" role="alert">@ViewBag.Error</div>
            }

            <!-- Results Toolbar -->
            <div class="results-toolbar">
                <div class="results-count">
                    @if (hasSearch)
                    {
                        <h2>@name için <strong>@Model.TotalCount.ToString("N0", tr) konaklama</strong> bulundu</h2>
                        <span>@Model.Checkin.ToString("d MMMM", tr) – @Model.Checkout.ToString("d MMMM yyyy", tr), @Model.Nights gece</span>
                    }
                    else
                    {
                        <h2>Arama yapmak için bir lokasyon girin</h2>
                    }
                </div>

                <div class="toolbar-actions">
                    <!-- Mobil filtre butonu (lg altında görünür) -->
                    <button class="btn btn-filter d-lg-none" type="button" data-bs-toggle="offcanvas"
                            data-bs-target="#filtersPanel" aria-controls="filtersPanel">
                        <i class="bi bi-sliders"></i> Filtrele
                    </button>

                    <div class="sort-box">
                        <label for="sortBy"><i class="bi bi-arrow-down-up"></i> Sırala</label>
                        <select id="sortBy" name="sortBy" form="searchForm" data-autosubmit class="form-select sort-select">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.SortBy))">Önerilen</option>
                            <option value="price" selected="@(Model.SortBy == "price")">En Düşük Fiyat</option>
                            <option value="review_score" selected="@(Model.SortBy == "review_score")">En Yüksek Puan</option>
                            <option value="class_descending" selected="@(Model.SortBy == "class_descending")">Yıldıza Göre</option>
                        </select>
                    </div>

                    <div class="view-switch d-none d-md-inline-flex" role="group" aria-label="Görünüm">
                        <button type="button" class="active" aria-pressed="true" aria-label="Liste görünümü"><i class="bi bi-list-ul"></i></button>
                        <button type="button" aria-pressed="false" aria-label="Grid görünümü"><i class="bi bi-grid"></i></button>
                    </div>
                </div>
            </div>

            <div class="row g-4">

                <!-- Filters (lg ve üzerinde sol kolon, altında offcanvas) -->
                <aside class="col-lg-3">
                    <div class="offcanvas-lg offcanvas-start filters-offcanvas" tabindex="-1" id="filtersPanel" aria-labelledby="filtersTitle">
                        <div class="filters-card">
                            <div class="filters-head">
                                <h2 id="filtersTitle">Filtreler</h2>
                                <div class="d-flex align-items-center gap-2">
                                    @if (hasFilters)
                                    {
                                        <a asp-action="HotelList" asp-all-route-data="clearRoute" class="clear-link">Tümünü Temizle</a>
                                    }
                                    <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas"
                                            data-bs-target="#filtersPanel" aria-label="Kapat"></button>
                                </div>
                            </div>

                            <div class="accordion filter-accordion" id="filterAccordion">

                                <!-- A. Fiyat -->
                                <div class="accordion-item">
                                    <h3 class="accordion-header">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#fPrice" aria-expanded="true" aria-controls="fPrice">
                                            Toplam Fiyat (@Model.Currency)
                                        </button>
                                    </h3>
                                    <div id="fPrice" class="accordion-collapse collapse show">
                                        <div class="accordion-body">
                                            <div class="row g-2">
                                                <div class="col-6">
                                                    <label class="mini-label" for="minPrice">Minimum</label>
                                                    <div class="price-input">
                                                        <span>@Model.Currency</span>
                                                        <input type="number" id="minPrice" name="minPrice" form="searchForm" min="0" value="@Model.MinPrice">
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <label class="mini-label" for="maxPrice">Maksimum</label>
                                                    <div class="price-input">
                                                        <span>@Model.Currency</span>
                                                        <input type="number" id="maxPrice" name="maxPrice" form="searchForm" min="0" value="@Model.MaxPrice">
                                                    </div>
                                                </div>
                                            </div>
                                            <button type="submit" form="searchForm" class="btn btn-primary-sf w-100 mt-2">Uygula</button>
                                        </div>
                                    </div>
                                </div>

                                <!-- B. Yıldız -->
                                <div class="accordion-item">
                                    <h3 class="accordion-header">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#fStars" aria-expanded="true" aria-controls="fStars">
                                            Yıldız Sayısı
                                        </button>
                                    </h3>
                                    <div id="fStars" class="accordion-collapse collapse show">
                                        <div class="accordion-body">
                                            @foreach (var n in new[] { 5, 4, 3, 2, 1 })
                                            {
                                                <label class="filter-option">
                                                    <input class="form-check-input" type="checkbox" name="stars" form="searchForm" data-autosubmit
                                                           value="@n" checked="@(selectedStars.Contains(n.ToString()))">
                                                    <span class="option-text"><span class="stars-inline">@(new string('★', n))</span> @n Yıldız</span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- C. Misafir Puanı -->
                                <div class="accordion-item">
                                    <h3 class="accordion-header">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#fScore" aria-expanded="true" aria-controls="fScore">
                                            Misafir Puanı
                                        </button>
                                    </h3>
                                    <div id="fScore" class="accordion-collapse collapse show">
                                        <div class="accordion-body">
                                            <label class="filter-option">
                                                <input class="form-check-input" type="radio" name="minScore" form="searchForm" data-autosubmit
                                                       value="" checked="@(!Model.MinScore.HasValue)">
                                                <span class="option-text">Farketmez</span>
                                            </label>
                                            @foreach (var o in scoreOptions)
                                            {
                                                <label class="filter-option">
                                                    <input class="form-check-input" type="radio" name="minScore" form="searchForm" data-autosubmit
                                                           value="@o.Item1" checked="@(Model.MinScore == o.Item1)">
                                                    <span class="option-text"><span class="score-chip">@(o.Item1)+</span> @o.Item2</span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- D. Diğer -->
                                <div class="accordion-item">
                                    <h3 class="accordion-header">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#fOther" aria-expanded="true" aria-controls="fOther">
                                            Diğer
                                        </button>
                                    </h3>
                                    <div id="fOther" class="accordion-collapse collapse show">
                                        <div class="accordion-body">
                                            <label class="filter-option">
                                                <input class="form-check-input" type="checkbox" name="freeCancellation" form="searchForm" data-autosubmit
                                                       value="true" checked="@Model.FreeCancellation">
                                                <span class="option-text">Ücretsiz İptal</span>
                                            </label>
                                            <label class="filter-option">
                                                <input class="form-check-input" type="checkbox" name="breakfast" form="searchForm" data-autosubmit
                                                       value="true" checked="@Model.Breakfast">
                                                <span class="option-text">Kahvaltı Dahil</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Mobilde sonuçları göster butonu -->
                            <div class="filters-footer d-lg-none">
                                <button type="submit" form="searchForm" class="btn btn-primary-sf w-100">
                                    @Model.TotalCount.ToString("N0", tr) sonucu göster
                                </button>
                            </div>
                        </div>
                    </div>
                </aside>

                <!-- Hotel Results -->
                <div class="col-lg-9">
                    <div class="hotel-list">

                        @if (Model.Hotels.Count == 0)
                        {
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-search fs-1 d-block mb-2"></i>
                                @(hasSearch ? "Aramanıza ve filtrelerinize uygun konaklama bulunamadı." : "Henüz bir arama yapılmadı.")
                            </div>
                        }

                        @foreach (var hotel in Model.Hotels)
                        {
                            <article class="hotel-card"
                                     data-hotel-id="@hotel.Id"
                                     data-city="@name"
                                     data-checkin="@checkinStr" data-checkout="@checkoutStr">
                                <div class="hotel-media">
                                    @if (!string.IsNullOrEmpty(hotel.Img))
                                    {
                                        <img src="@hotel.Img" alt="@hotel.Name" loading="lazy">
                                    }
                                    <button type="button" class="fav-btn" aria-label="Favorilere ekle"><i class="bi bi-heart"></i></button>
                                    @if (!string.IsNullOrEmpty(hotel.MediaBadge))
                                    {
                                        <span class="media-badge">@hotel.MediaBadge</span>
                                    }
                                </div>

                                <div class="hotel-info">
                                    <h3 class="hotel-name">
                                        <a asp-action="HotelDetail" asp-route-id="@hotel.Id"
                                           asp-route-checkin="@checkinStr" asp-route-checkout="@checkoutStr"
                                           asp-route-adults="@Model.Adults" asp-route-childrenAges="@Model.ChildrenAges"
                                           asp-route-rooms="@Model.Rooms" asp-route-currency="@Model.Currency"
                                           asp-route-stars="@hotel.Stars" asp-route-score="@hotel.Score"
                                           asp-route-scoreWord="@hotel.ScoreWord">@hotel.Name</a>
                                    </h3>

                                    @if (hotel.Stars > 0)
                                    {
                                        <div class="hotel-stars">
                                            <span class="stars" aria-label="@hotel.Stars yıldız">@(new string('★', hotel.Stars))</span>
                                            <span class="stars-text">@hotel.Stars Yıldızlı Otel</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(hotel.Location))
                                    {
                                        <p class="hotel-location">
                                            <i class="bi bi-geo-alt"></i>
                                            <span>@hotel.Location</span>
                                            <a asp-action="HotelDetail" asp-route-id="@hotel.Id" asp-fragment="location" class="map-link">Haritada göster</a>
                                        </p>
                                    }

                                    @if (!string.IsNullOrEmpty(hotel.Distance))
                                    {
                                        <p class="hotel-distance"><i class="bi bi-signpost-2"></i> @hotel.Distance</p>
                                    }

                                    @if (hotel.Facilities.Count > 0)
                                    {
                                        <ul class="facility-list">
                                            @foreach (var f in hotel.Facilities)
                                            {
                                                <li><i class="bi @f.Icon"></i> @f.Text</li>
                                            }
                                        </ul>
                                    }

                                    @if (hotel.BadgeKind == "deal")
                                    {
                                        <span class="deal-badge"><i class="bi @hotel.BadgeIcon"></i> @hotel.BadgeText</span>
                                    }
                                    else if (hotel.BadgeKind == "view")
                                    {
                                        <span class="view-badge"><i class="bi @hotel.BadgeIcon"></i> @hotel.BadgeText</span>
                                    }
                                </div>

                                <div class="hotel-side">
                                    <div class="rating">
                                        <div class="rating-text">
                                            <strong>@hotel.ScoreWord</strong>
                                            <span>@hotel.Reviews değerlendirme</span>
                                        </div>
                                        <span class="rating-score">@hotel.Score</span>
                                    </div>
                                    <div class="price-box">
                                        <span class="price-meta">@Model.Nights gece, @guestText</span>
                                        @if (!string.IsNullOrEmpty(hotel.OldPrice))
                                        {
                                            <s class="old-price">@hotel.OldPrice</s>
                                        }
                                        <span class="price">@hotel.Price</span>
                                        <span class="price-note">@hotel.PriceNote</span>
                                        <a asp-action="HotelDetail" asp-route-id="@hotel.Id"
                                           asp-route-checkin="@checkinStr" asp-route-checkout="@checkoutStr"
                                           asp-route-adults="@Model.Adults" asp-route-childrenAges="@Model.ChildrenAges"
                                           asp-route-rooms="@Model.Rooms" asp-route-currency="@Model.Currency"
                                           asp-route-stars="@hotel.Stars" asp-route-score="@hotel.Score"
                                           asp-route-scoreWord="@hotel.ScoreWord"
                                           class="btn btn-detail">Detayları Gör</a>
                                    </div>
                                </div>
                            </article>
                        }

                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav class="pagination-wrap" aria-label="Sonuç sayfaları">
                            <span class="pagination-info">@firstItem-@lastItem / @Model.TotalCount.ToString("N0", tr) sonuç</span>
                            <ul class="pagination sf-pagination mb-0">
                                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                    <a class="page-link" asp-action="HotelList" asp-all-route-data="PageRoute(Math.Max(1, Model.Page - 1))" aria-label="Önceki sayfa"><i class="bi bi-chevron-left"></i></a>
                                </li>

                                @if (pageStart > 1)
                                {
                                    <li class="page-item"><a class="page-link" asp-action="HotelList" asp-all-route-data="PageRoute(1)">1</a></li>
                                    if (pageStart > 2)
                                    {
                                        <li class="page-item disabled"><span class="page-link">…</span></li>
                                    }
                                }

                                @for (var i = pageStart; i <= pageEnd; i++)
                                {
                                    <li class="page-item @(i == Model.Page ? "active" : "")" aria-current="@(i == Model.Page ? "page" : null)">
                                        <a class="page-link" asp-action="HotelList" asp-all-route-data="PageRoute(i)">@i</a>
                                    </li>
                                }

                                @if (pageEnd < Model.TotalPages)
                                {
                                    if (pageEnd < Model.TotalPages - 1)
                                    {
                                        <li class="page-item disabled"><span class="page-link">…</span></li>
                                    }
                                    <li class="page-item"><a class="page-link" asp-action="HotelList" asp-all-route-data="PageRoute(Model.TotalPages)">@Model.TotalPages</a></li>
                                }

                                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" asp-action="HotelList" asp-all-route-data="PageRoute(Math.Min(Model.TotalPages, Model.Page + 1))" aria-label="Sonraki sayfa"><i class="bi bi-chevron-right"></i></a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script>
        // Filtre veya sıralama değişince formu gönder (sayfa otomatik 1'e döner)
        var searchForm = document.getElementById('searchForm');
        document.querySelectorAll('[data-autosubmit]').forEach(function (el) {
            el.addEventListener('change', function () { searchForm.requestSubmit(); });
        });
    </script>
}
