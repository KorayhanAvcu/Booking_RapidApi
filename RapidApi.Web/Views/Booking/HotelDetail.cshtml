@using System.Globalization
@model HotelDetailViewModel
@{
    var tr = new CultureInfo("tr-TR");
    var inv = CultureInfo.InvariantCulture;

    var checkinStr = Model.Checkin.ToString("yyyy-MM-dd");
    var checkoutStr = Model.Checkout.ToString("yyyy-MM-dd");
    var checkinText = Model.Checkin.ToString("d MMMM yyyy", tr);
    var checkoutText = Model.Checkout.ToString("d MMMM yyyy", tr);
    var guestText = $"{Model.Adults} Yetişkin" + (Model.ChildCount > 0 ? $", {Model.ChildCount} Çocuk" : "");

    ViewData["Title"] = Model.HasError ? "Otel Detayı" : Model.Name;
    ViewData["Description"] = Model.HasError ? "Otel detayı" : $"{Model.Name}: {Model.Summary}";
    ViewData["ActivePage"] = "hotels";

    // Liste sayfasına dönüş linki (aramayı korur)
    var listDestination = !string.IsNullOrEmpty(Model.City) ? Model.City : Model.Name;
    var backRoute = new Dictionary<string, string>
    {
        ["destination"] = listDestination,
        ["checkin"] = checkinStr,
        ["checkout"] = checkoutStr,
        ["adults"] = Model.Adults.ToString(),
        ["rooms"] = Model.Rooms.ToString(),
        ["currency"] = Model.Currency
    };
    if (!string.IsNullOrEmpty(Model.ChildrenAges)) backRoute["childrenAges"] = Model.ChildrenAges;

    var fullAddress = string.Join(", ", new[] { Model.Address, Model.City, Model.Country }
        .Where(s => !string.IsNullOrWhiteSpace(s)));

    var gallery = Model.Photos.Take(5).ToList();
    var extraPhotoCount = Math.Max(0, Model.Photos.Count - 5);
}

@section Styles {
    <link rel="stylesheet" href="~/css/hotel-detail.css" asp-append-version="true" />
}

@if (Model.HasError)
{
    <main class="hotel-page">
        <div class="container py-5">
            <div class="alert alert-warning" role="alert">@Model.Error</div>
            <a asp-action="Index" class="btn btn-primary-sf">Ana Sayfaya Dön</a>
        </div>
    </main>
}
else
{
    @* HotelId, Latitude ve Longitude değerleri data-* özelliklerinde tutulur *@
    <main class="hotel-page"
          data-hotel-id="@Model.HotelId"
          data-city="@Model.City" data-country="@Model.Country"
          data-latitude="@Model.Latitude.ToString(inv)" data-longitude="@Model.Longitude.ToString(inv)"
          data-checkin="@checkinStr" data-checkout="@checkoutStr"
          data-currency="@Model.Currency">

        <div class="container">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb sf-breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Ana Sayfa</a></li>
                    <li class="breadcrumb-item"><a asp-action="HotelList">Oteller</a></li>
                    @if (!string.IsNullOrEmpty(Model.City))
                    {
                        <li class="breadcrumb-item"><a asp-action="HotelList" asp-all-route-data="backRoute">@Model.City</a></li>
                    }
                    <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
                </ol>
            </nav>

            <!-- Hotel Heading -->
            <section class="hotel-heading">
                <div class="heading-main">
                    <h1 class="hotel-title">@Model.Name</h1>

                    @if (Model.Stars > 0)
                    {
                        <div class="hotel-stars">
                            <span class="stars" aria-label="@Model.Stars yıldız">@(new string('★', Model.Stars))</span>
                            <span class="stars-text">@Model.Stars Yıldızlı @Model.AccommodationType</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(fullAddress))
                    {
                        <p class="hotel-address">
                            <i class="bi bi-geo-alt"></i>
                            <span>@fullAddress</span>
                            <a href="#location" class="map-link">Haritada Göster</a>
                        </p>
                    }
                </div>

                <div class="heading-side">
                    @if (Model.ReviewCount > 0 || !string.IsNullOrEmpty(Model.Score))
                    {
                        <div class="heading-rating">
                            <div class="rating-text">
                                @if (!string.IsNullOrEmpty(Model.ScoreWord))
                                {
                                    <strong>@Model.ScoreWord</strong>
                                }
                                @if (Model.ReviewCount > 0)
                                {
                                    <span>@Model.ReviewCount.ToString("N0", tr) değerlendirme</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Score))
                            {
                                <span class="rating-score rating-score-lg">@Model.Score</span>
                            }
                        </div>
                    }
                    <div class="heading-actions">
                        <button type="button" class="icon-btn fav-btn" aria-label="Favorilere ekle"><i class="bi bi-heart"></i></button>
                        <button type="button" class="icon-btn" aria-label="Paylaş"><i class="bi bi-share"></i></button>
                    </div>
                </div>
            </section>

            <!-- Hotel Gallery -->
            @if (gallery.Count > 0)
            {
                <section class="hotel-gallery" aria-label="Otel fotoğrafları">
                    @for (var i = 0; i < gallery.Count; i++)
                    {
                        var ph = gallery[i];
                        if (i == 0)
                        {
                            <a href="#hotelPhotos" class="gallery-item gallery-main">
                                <img src="@ph.Url" alt="@Model.Name">
                            </a>
                        }
                        else if (i == 4 && extraPhotoCount > 0)
                        {
                            <a href="#hotelPhotos" class="gallery-item gallery-more">
                                <img src="@ph.Thumb" alt="@(string.IsNullOrEmpty(ph.Caption) ? Model.Name : ph.Caption)" loading="lazy">
                                <span class="gallery-overlay"><i class="bi bi-images"></i> +@extraPhotoCount Fotoğraf</span>
                            </a>
                        }
                        else
                        {
                            <a href="#hotelPhotos" class="gallery-item">
                                <img src="@ph.Thumb" alt="@(string.IsNullOrEmpty(ph.Caption) ? Model.Name : ph.Caption)" loading="lazy">
                                @if (!string.IsNullOrEmpty(ph.Caption))
                                {
                                    <span class="gallery-tag">@ph.Caption</span>
                                }
                            </a>
                        }
                    }
                </section>
            }

            <div class="row g-4 g-xl-5 detail-layout">

                <!-- Sol kolon: detay içerikleri -->
                <div class="col-lg-8">

                    <!-- Hotel About -->
                    <section class="detail-block" id="about">
                        <h2 class="block-title">Otel Hakkında</h2>
                        <div class="about-text">
                            <p>@Model.Summary</p>
                        </div>
                        @if (Model.Highlights.Count > 0)
                        {
                            <ul class="tag-list">
                                @foreach (var h in Model.Highlights)
                                {
                                    <li><i class="bi @h.Icon"></i> @h.Name</li>
                                }
                            </ul>
                        }
                    </section>

                    <!-- Facilities -->
                    @if (Model.Facilities.Count > 0 || Model.FamilyFacilities.Count > 0)
                    {
                        <section class="detail-block" id="facilities">
                            <h2 class="block-title">Popüler Özellikler</h2>

                            @if (Model.Facilities.Count > 0)
                            {
                                <div class="row g-3 facility-grid">
                                    @foreach (var f in Model.Facilities)
                                    {
                                        <div class="col-6 col-md-4">
                                            <div class="facility-item">
                                                <span class="facility-icon"><i class="bi @f.Icon"></i></span>
                                                <span class="facility-text"><strong>@f.Name</strong></span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @if (Model.FamilyFacilities.Count > 0)
                            {
                                <p class="block-text mt-4 mb-2"><strong>Aile İmkanları</strong></p>
                                <ul class="tag-list">
                                    @foreach (var f in Model.FamilyFacilities)
                                    {
                                        <li><i class="bi bi-people"></i> @f</li>
                                    }
                                </ul>
                            }
                        </section>
                    }

                    <!-- Location -->
                    <section class="detail-block" id="location">
                        <h2 class="block-title">Otel Konumu</h2>
                        <div class="location-card">
                            @if (!string.IsNullOrEmpty(Model.MapEmbedUrl))
                            {
                                <div class="map-placeholder" role="img" aria-label="Otel konumu haritası">
                                    <iframe src="@Model.MapEmbedUrl" title="@Model.Name konumu" loading="lazy"
                                            style="width:100%;height:100%;min-height:280px;border:0;"></iframe>
                                </div>
                            }

                            <div class="location-body">
                                @if (!string.IsNullOrEmpty(fullAddress))
                                {
                                    <p class="location-address">
                                        <i class="bi bi-geo-alt"></i>
                                        <span>@fullAddress</span>
                                    </p>
                                }

                                @if (Model.DistanceToCenter.HasValue)
                                {
                                    <ul class="nearby-list">
                                        <li>
                                            <span><i class="bi bi-buildings"></i> Şehir Merkezi</span>
                                            <strong>@Model.DistanceToCenter.Value.ToString("0.#", tr) km</strong>
                                        </li>
                                    </ul>
                                }

                                @if (!string.IsNullOrEmpty(Model.MapLinkUrl))
                                {
                                    <a href="@Model.MapLinkUrl" target="_blank" rel="noopener" class="map-link">Google Haritalar'da aç</a>
                                }
                            </div>
                        </div>
                    </section>

                    <!-- Rooms -->
                    <section class="detail-block" id="rooms">
                        <div class="block-head">
                            <h2 class="block-title">Uygun Odalar</h2>
                            <p class="block-text">@checkinText - @checkoutText · @Model.Nights Gece · @guestText · @Model.Rooms Oda</p>
                        </div>

                        <div class="room-list">

                            @if (Model.RoomOptions.Count == 0 || Model.SoldOut)
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                                    Seçilen tarihlerde müsait oda bulunamadı. Farklı tarihler deneyebilirsiniz.
                                </div>
                            }

                            @foreach (var room in Model.RoomOptions)
                            {
                                var featured = room.IsRecommended && Model.RoomOptions.Count > 1;
                                <article class="room-card @(featured ? "room-card-featured" : "")" data-room-id="@room.Id">
                                    <div class="room-media">
                                        @if (!string.IsNullOrEmpty(room.Img))
                                        {
                                            <img src="@room.Img" alt="@room.Name" loading="lazy">
                                        }
                                        @if (featured)
                                        {
                                            <span class="media-badge">Önerilen</span>
                                        }
                                    </div>

                                    <div class="room-info">
                                        <h3 class="room-name">@room.Name</h3>

                                        @if (room.Specs.Count > 0)
                                        {
                                            <ul class="room-specs">
                                                @foreach (var s in room.Specs)
                                                {
                                                    <li><i class="bi @s.Icon"></i> @s.Text</li>
                                                }
                                            </ul>
                                        }

                                        @if (room.Perks.Count > 0)
                                        {
                                            <ul class="room-perks">
                                                @foreach (var p in room.Perks)
                                                {
                                                    <li class="@(p.Positive ? "perk-positive" : "")"><i class="bi @p.Icon"></i> @p.Text</li>
                                                }
                                            </ul>
                                        }

                                        @if (room.PolicyKind == "free")
                                        {
                                            <span class="policy-text policy-free"><i class="bi bi-check2-circle"></i> @room.PolicyText</span>
                                        }
                                        else
                                        {
                                            <span class="policy-text"><i class="bi bi-info-circle"></i> @room.PolicyText</span>
                                        }

                                        @if (!string.IsNullOrEmpty(room.PrepayText))
                                        {
                                            <span class="policy-text d-block"><i class="bi bi-credit-card"></i> @room.PrepayText</span>
                                        }
                                    </div>

                                    <div class="room-price">
                                        @if (!string.IsNullOrEmpty(room.Price))
                                        {
                                            <span class="price-meta">@Model.Nights gece için</span>
                                            <span class="price">@room.Price</span>
                                            <span class="price-note">@room.PriceNote</span>
                                        }
                                        else
                                        {
                                            <span class="price-note">Bu seçenek için fiyat bilgisi yok</span>
                                        }
                                        <button type="button" class="btn btn-primary-sf w-100">Odayı Seç</button>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>

                    <!-- Reviews -->
                    @if (Model.ReviewCount > 0 || !string.IsNullOrEmpty(Model.Score))
                    {
                        <section class="detail-block" id="reviews">
                            <h2 class="block-title">Misafir Değerlendirmeleri</h2>

                            <div class="review-summary">
                                <div class="review-score-box">
                                    @if (!string.IsNullOrEmpty(Model.Score))
                                    {
                                        <span class="review-big">@Model.Score</span>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ScoreWord))
                                    {
                                        <strong>@Model.ScoreWord</strong>
                                    }
                                    @if (Model.ReviewCount > 0)
                                    {
                                        <span>@Model.ReviewCount.ToString("N0", tr) değerlendirme</span>
                                    }
                                </div>
                            </div>
                        </section>
                    }

                    <!-- Important info -->
                    @if (Model.ImportantInfo.Count > 0)
                    {
                        <section class="detail-block" id="info">
                            <h2 class="block-title">Önemli Bilgiler</h2>
                            <ul class="mb-0 ps-3">
                                @foreach (var info in Model.ImportantInfo)
                                {
                                    <li class="mb-2">@info</li>
                                }
                            </ul>
                        </section>
                    }
                </div>

                <!-- Booking Summary -->
                <aside class="col-lg-4">
                    <div class="booking-card">
                        <h2 class="booking-title">Konaklama Özeti</h2>

                        <dl class="booking-list">
                            <div><dt><i class="bi bi-box-arrow-in-right"></i> Giriş</dt><dd>@checkinText</dd></div>
                            <div><dt><i class="bi bi-box-arrow-right"></i> Çıkış</dt><dd>@checkoutText</dd></div>
                            <div><dt><i class="bi bi-moon"></i> Süre</dt><dd>@Model.Nights Gece</dd></div>
                            <div><dt><i class="bi bi-people"></i> Misafir</dt><dd>@guestText</dd></div>
                            <div><dt><i class="bi bi-door-closed"></i> Oda</dt><dd>@Model.Rooms Oda</dd></div>
                        </dl>

                        @if (Model.Price != null)
                        {
                            <div class="booking-price">
                                <span class="price-meta">Toplam konaklama fiyatı</span>
                                <span class="price price-lg">@Model.Price.Gross</span>
                                <span class="price-meta">
                                    @Model.Nights gece için @(Model.Price.PerNight != null ? $"· gecelik {Model.Price.PerNight}" : "")
                                </span>
                            </div>

                            <dl class="booking-total">
                                <div><dt>Konaklama</dt><dd>@Model.Price.Gross</dd></div>
                                @if (Model.Price.Taxes != null)
                                {
                                    <div><dt>Ek vergi ve ücretler</dt><dd>@Model.Price.Taxes</dd></div>
                                }
                                <div class="total-row"><dt>Toplam</dt><dd>@Model.Price.Total</dd></div>
                            </dl>
                        }
                        else
                        {
                            <p class="text-muted my-3">Seçilen tarihler için fiyat bilgisi bulunamadı.</p>
                        }

                        <a href="#rooms" class="btn btn-book w-100">
                            <i class="bi bi-door-open"></i> Oda Seç
                        </a>

                        <ul class="trust-list">
                            <li><i class="bi bi-check2"></i> Güvenli İşlem</li>
                            @if (Model.RoomOptions.Any(r => r.PolicyKind == "free"))
                            {
                                <li><i class="bi bi-check2"></i> Ücretsiz İptal Seçenekleri</li>
                            }
                            @if (Model.RoomOptions.Any(r => !string.IsNullOrEmpty(r.PrepayText)))
                            {
                                <li><i class="bi bi-check2"></i> Ön Ödeme Gerekmez</li>
                            }
                        </ul>
                    </div>
                </aside>
            </div>

            <!-- Hotel Photos Slider -->
            @if (Model.Photos.Count > 0)
            {
                <section class="detail-block photos-block" id="hotelPhotos">
                    <div class="photos-head">
                        <div>
                            <h2 class="block-title">@Model.Name Fotoğrafları</h2>
                            <p class="block-text">Odaları ve otelin sunduğu imkanları daha yakından inceleyin.</p>
                        </div>
                        <div class="slider-nav">
                            <button type="button" class="slider-btn" data-dir="-1" aria-label="Önceki fotoğraflar"><i class="bi bi-chevron-left"></i></button>
                            <button type="button" class="slider-btn" data-dir="1" aria-label="Sonraki fotoğraflar"><i class="bi bi-chevron-right"></i></button>
                        </div>
                    </div>

                    <div class="photo-track" id="photoTrack" tabindex="0" aria-label="Otel fotoğrafları kaydırılabilir alan">
                        @foreach (var p in Model.Photos)
                        {
                            <figure class="photo-item">
                                <a href="@p.Url" class="photo-frame" target="_blank" rel="noopener"
                                   aria-label="@(string.IsNullOrEmpty(p.Caption) ? Model.Name : p.Caption) fotoğrafını büyüt">
                                    <img src="@p.Thumb" alt="@(string.IsNullOrEmpty(p.Caption) ? Model.Name : p.Caption)" loading="lazy">
                                    <span class="photo-zoom"><i class="bi bi-arrows-fullscreen"></i></span>
                                </a>
                                @if (!string.IsNullOrEmpty(p.Caption))
                                {
                                    <figcaption><span class="photo-cat">@p.Caption</span></figcaption>
                                }
                            </figure>
                        }
                    </div>
                </section>
            }
        </div>
    </main>
}

@section Scripts {
    <script src="~/js/hotel-detail.js" asp-append-version="true"></script>
}
